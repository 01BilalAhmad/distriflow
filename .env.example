# DistriFlow environment template — copy to .env and fill in.
# NEVER commit the real .env file (it is gitignored).

# PostgreSQL connection string (Neon or any managed Postgres).
# Used by Prisma (prisma/schema.prisma datasource).
DATABASE_URL="postgresql://user:password@host:5432/distriflow"

# HMAC secret that signs the dms_auth session cookie (src/lib/auth-token.ts).
# REQUIRED in production — if unset, a hardcoded dev fallback is used and
# session cookies become forgeable (audit Finding: CRITICAL).
# Generate a strong secret with:  openssl rand -hex 32
AUTH_SECRET=""

# NODE_ENV is normally set by the platform (development / production) —
# do not set it manually in deployed environments.
# NODE_ENV="development"
